
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkItemType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  memberships  Membership[]
  createdItems WorkItem[]      @relation("CreatedItems")
  assignedItems WorkItem[]     @relation("AssignedItems")
  activities   ActivityEvent[] @relation("ActivityActor")
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())

  memberships Membership[]
  workItems   WorkItem[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      TeamRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, role])
}

model WorkItem {
  id          String         @id @default(cuid())
  title       String
  description String         @default("")
  type        WorkItemType   @default(TASK)
  priority    Priority       @default(MEDIUM)
  status      WorkItemStatus @default(OPEN)

  teamId      String
  assigneeId  String?
  createdById String

  dueDate     DateTime?
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignee  User? @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User  @relation("CreatedItems", fields: [createdById], references: [id], onDelete: Restrict)

  activities ActivityEvent[]

  @@index([teamId, status, priority])
  @@index([assigneeId, status, updatedAt])
  @@index([createdAt, id])
  @@index([dueDate, status])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  workItemId String
  actorId    String
  action     String
  details    Json?
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  actor    User     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt, id])
}
